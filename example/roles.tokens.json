{
  "surface": {
    "$type": "color",
    "raised": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      },
      "$description": "Cards, menus and the face of a control: one step above the page."
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.4,
          0.902
        ],
        "hex": "#1a66e6"
      }
    },
    "selected": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.8784,
          0.9216,
          0.9882
        ],
        "hex": "#e0ebfc"
      }
    }
  },
  "text": {
    "$type": "color",
    "default": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.102,
          0.102
        ],
        "hex": "#1a1a1a"
      }
    },
    "on-accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4,
          0.4,
          0.4
        ],
        "hex": "#666666"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "md": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    }
  },
  "type": {
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Inter",
          "Helvetica Neue",
          "sans-serif"
        ],
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 500,
        "lineHeight": 1.25
      }
    }
  }
}
